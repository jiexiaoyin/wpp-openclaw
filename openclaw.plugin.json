        "webhookPath": {
          "label": "Webhook Path",
          "placeholder": "/wechatpadpro/webhook"
        },
        "webhookHost": {
          "label": "Webhook Host",
          "placeholder": "127.0.0.1"
        },
        "webhookSecret": {
          "label": "Webhook Secret",
          "sensitive": true
        },
        "selfWxid": {
          "label": "Bot self wxid",
          "placeholder": "wxid_xxx (登录后回填)"
        },
        "nickname": {
          "label": "Bot 昵称",
          "placeholder": "YourBot"
        },
        "groupPolicy": {
          "label": "群聊策略",
          "placeholder": "open"
        },
        "allowFrom": {
          "label": "允许的私聊发送方 wxid 白名单"
        },
        "groupAllowFrom": {
          "label": "允许的群 wxid 白名单"
        },
        "requireAtMention": {
          "label": "群聊需 @ 才回复"
        },
        "debounceMs": {
          "label": "群消息防抖毫秒"
        },
        "webhookBusinessPath": {
          "label": "Business Callback Path",
          "placeholder": "/wechatpadpro/default/webhook/business"
        },
        "adminUsers": {
          "label": "管理员 wxid 列表"
        },
        "commandAllowlist": {
          "label": "命令白名单"
        },
        "sync": {
          "label": "WS 重连 + 同步参数"
        },
        "blacklistGroups": {
          "label": "黑名单群"
        },
        "chatroomDebug": {
          "label": "调试模式"
        }
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "storage": {
        "type": "object",
        "properties": {
          "saveHistory": {
            "type": "boolean"
          },
          "db": {
            "type": "object",
            "properties": {
              "backend": {
                "type": "string",
                "enum": [
                  "mariadb",
                  "mysql",
                  "sqlite"
                ]
              },
              "mariadb": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "number"
                  },
                  "user": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "passwordEnv": {
                    "type": "string"
                  },
                  "database": {
                    "type": "string"
                  },
                  "connectionLimit": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "_p0_pollution_fix": "v1.1.16 (2026-08-08 16:21) — P0 污染修复: dispatcher 读 cfg.agent, DM 白名单, cfg.agent 必填校验"
}