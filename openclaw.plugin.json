{
  "name": "wechatpadpro",
  "id": "wechatpadpro",
  "version": "1.5.4",
  "description": "WeChatPadPro (微信 Pad 协议 HTTP API) OpenClaw adapter plugin. 多账号 AccountRegistry (B 方案 accounts/<id>.json 独立配置). 收发文本/图片/语音/视频/文件; 语音 silk 自动转码 + 失败降级发文件; 群接龙自动触发 AI 应景回复; 引用回复; 文件确定性回复; 完整 313 paths API 覆盖 (新 vendor v2026.08.18.1); v1.3.75 HEARTFLOW 心流主动回复 (未@群消息小模型5维打分自动参与); v1.3.76 JARGON 群黑话挖掘 (自主学习, AI 可查群黑话含义); v1.3.77 AFFECTION 好感度/社交关系系统 (交互分类→好感度+情绪注入回复风格) + AI-UNIFY 统一判断模型配置; v1.3.78 完整审阅加固 (webhook token 强制 / 群白名单 fail-closed / WS v1 解析 / 去重账号隔离 / 心流冷却 / jargon 计数 / affection 去单字误判 / WS 长退避 / synckey 崩溃 / DB 重试 / sync 锁); v1.3.79 三功能 filehelper 命令 (/heartflow /affection /jargon 开关) + 账号专属配置热生效.",
  "kind": "plugin",
  "configUiHints": {
    "tokenKey": {
      "label": "WeChatPadPro TokenKey",
      "sensitive": true,
      "help": "vendor 后台获取; 也可用 WECHATPRO_TOKEN_KEY env"
    },
    "authcode": {
      "label": "授权码 authcode",
      "sensitive": true,
      "help": "vendor 启动时生成; 也可用 WECHATPRO_AUTHCODE env"
    },
    "apiBaseUrl": {
      "label": "API Base URL",
      "placeholder": "https://wx.juhe.chat",
      "help": "vendor HTTP API 地址"
    },
    "wsUrl": {
      "label": "WebSocket URL",
      "placeholder": "wss://wx.juhe.chat/ws/sync",
      "help": "vendor WS 推送地址"
    },
    "allowFrom": {
      "label": "私聊白名单 (逗号分隔)",
      "help": "空 = 拒绝所有 DM (fail-closed)"
    },
    "groupPolicy": {
      "label": "群聊策略",
      "help": "open/disabled/allowlist/closed"
    },
    "groupAllowFrom": {
      "label": "群白名单 (逗号分隔, @chatroom)",
      "help": "groupPolicy=allowlist 时用"
    },
    "agent": {
      "label": "OpenClaw agent id",
      "help": "绑定 agent (如 wpp-wechat), 禁止 main"
    },
    "webhookPort": {
      "label": "webhook 端口",
      "help": "默认 4398 (多账号共享)"
    }
  },
  "channels": [
    "wechatpadpro"
  ],
  "skills": [],
  "channelConfigs": {
    "wechatpadpro": {
      "label": "WeChatPadPro",
      "description": "WeChatPadPro 微信 Pad 协议 HTTP API 适配 (vendor: knowhub.cloud adminmaxapi). 部署在 /opt/1panel/docker/compose/WechatPadPro/, 反代 https://wx.juhe.chat/api/.",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "启用此账号"
          },
          "nickname": {
            "type": "string",
            "description": "机器人昵称"
          },
          "selfWxid": {
            "type": "string",
            "readOnly": true,
            "description": "当前登录的微信 wxid (扫码登录后回填; 只读身份标识, 勿改)"
          },
          "agent": {
            "type": "string",
            "description": "绑定 OpenClaw agent id (如 wpp-wechat)"
          },
          "adminUsers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "管理员 wxid 列表 (默认 [selfWxid]; 限频/脱敏/优先回复豁免)"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "允许的私聊发送方 wxid 白名单 (空=fail-closed 全拒)"
          },
          "groupPolicy": {
            "type": "string",
            "enum": [
              "open",
              "disabled",
              "allowlist",
              "closed"
            ],
            "description": "群聊策略 (open 放行 / disabled 拒绝 / allowlist 白名单 / closed 拒绝)"
          },
          "groupAllowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "允许的群 wxid 白名单 (@chatroom; groupPolicy=allowlist 时用)"
          },
          "blacklistGroups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "黑名单群 wxid (拒绝处理任何消息)"
          },
          "requireAtMention": {
            "type": "boolean",
            "description": "群聊需 @ 才回复"
          },
          "dmPairingEnabled": {
            "type": "boolean",
            "description": "启用 DM 配对码 (默认 false)"
          },
          "friendCirclePublishEnabled": {
            "type": "boolean",
            "description": "朋友圈发布开关 (v1.3.41): true=启用但仅 friendCirclePublishAllowFrom / adminUsers 内 wxid 可发; false=完全禁用"
          },
          "friendCirclePublishAllowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "朋友圈发布白名单 wxid (缺省用 adminUsers; 未配则全禁)"
          },
          "heartflow": {
            "type": "object",
            "description": "心流主动回复 (群聊未@消息小模型打分自动参与)。enabled=false (默认) 关; true 开。高级参数/阈值在账号文件手调",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "总开关 (默认 false)"
              }
            }
          },
          "jargon": {
            "type": "object",
            "description": "群黑话挖掘 (自主学习)。enabled=false (默认) 关; true 开。高级参数在账号文件手调",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "总开关 (默认 false)"
              }
            }
          },
          "affection": {
            "type": "object",
            "description": "好感度/社交关系系统。enabled 开关。高级参数在账号文件手调",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "总开关 (v1.5.2 默认 true)"
              }
            }
          }
        }
      },
      "uiHints": {
        "nickname": {
          "label": "Bot 昵称",
          "placeholder": "益融小助理"
        },
        "selfWxid": {
          "label": "当前微信 wxid (只读身份)",
          "placeholder": "wxid_xxx (登录后回填, 勿改)"
        },
        "agent": {
          "label": "OpenClaw agent id",
          "placeholder": "wpp-wechat"
        },
        "adminUsers": {
          "label": "管理员 wxid (逗号分隔)"
        },
        "allowFrom": {
          "label": "允许私聊发送方 wxid (逗号分隔)"
        },
        "groupPolicy": {
          "label": "群聊策略",
          "placeholder": "allowlist"
        },
        "groupAllowFrom": {
          "label": "允许群 wxid (逗号分隔)"
        },
        "blacklistGroups": {
          "label": "黑名单群 wxid (逗号分隔)"
        },
        "requireAtMention": {
          "label": "群聊需 @ 才回复"
        },
        "dmPairingEnabled": {
          "label": "启用 DM 配对码"
        },
        "friendCirclePublishEnabled": {
          "label": "朋友圈发布开关"
        },
        "friendCirclePublishAllowFrom": {
          "label": "朋友圈发布白名单 wxid (逗号分隔)"
        },
        "heartflow": {
          "label": "心流主动回复"
        },
        "jargon": {
          "label": "群黑话挖掘"
        },
        "affection": {
          "label": "好感度系统"
        }
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "storage": {
        "type": "object",
        "properties": {
          "saveHistory": {
            "type": "boolean"
          },
          "db": {
            "type": "object",
            "properties": {
              "backend": {
                "type": "string",
                "enum": [
                  "mariadb",
                  "mysql",
                  "sqlite"
                ]
              },
              "mariadb": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "type": "number"
                  },
                  "user": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "passwordEnv": {
                    "type": "string"
                  },
                  "database": {
                    "type": "string"
                  },
                  "connectionLimit": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "_p0_pollution_fix": "v1.1.16 (2026-08-08 16:21) — P0 污染修复: dispatcher 读 cfg.agent, DM 白名单, cfg.agent 必填校验"
}
