{
  "name": "wechatpadpro",
  "version": "1.3.79",
  "description": "WeChatPadPro (微信 Pad 协议) OpenClaw plugin. 单账号 demo (accounts/<id>.json 独立配置), 复用 1Panel-mariadb-RlbK, 共存模式与 本项目 并行.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc --watch --noEmit",
    "test": "tsx --test --test-force-exit tests/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=html --include=src tsx --test --test-force-exit tests/*.test.ts",
    "lint": "eslint src/ tests/",
    "setup": "tsx scripts/setup.ts",
    "deploy": "bash deploy.sh",
    "deploy-swap": "bash deploy-swap.sh"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mysql2": "^3.22.5",
    "typebox": "^1.3.10",
    "undici": "^6.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/ws": "^8.5.13",
    "c8": "^12.0.0",
    "eslint": "^9.18.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
