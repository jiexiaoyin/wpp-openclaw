# WeChatPadPro OpenClaw Plugin v1.0.1 — Environment Variables Example
# 2026-08-04 老板铁律: 凭证单一来源 env var, 不进 JSON 不进 DB
#
# 使用:
#   1. cp .env.example .env
#   2. 编辑 .env 填真值
#   3. systemd: 写到 /root/.openclaw/gateway.systemd.env (被 openclaw-gateway.service 加载)
#      或: 临时调试: export $(cat .env | xargs) && npm test
#
# ⚠️ .env 文件不进 git (已在 .gitignore 排除)

# ============================================================
# 必填 (部署后必须配)
# ============================================================

# MariaDB / MySQL 密码 (老板 2026-08-01 铁律: env 单一来源)
# config.json 中 storage.db.mariadb.passwordEnv = "WECHATPRO_DB_PASSWORD"
# 部署时由 deploy-swap.sh 自动注入, 但 placeholder 必须替换成真密码
WECHATPRO_DB_PASSWORD=

# WeChatPadPro vendor API TokenKey
# accounts/default.json 中 tokenKeyEnv = "WECHATPRO_TOKEN_KEY"
# 从 vendor 后台 adminmax.knowhub.cloud 拿
WECHATPRO_TOKEN_KEY=

# 授权码 (binary 启动时生成, 用于 WebSocket 鉴权)
# accounts/default.json 中 authcodeEnv = "WECHATPRO_AUTHCODE"
WECHATPRO_AUTHCODE=

# ============================================================
# 可选 (有默认值)
# ============================================================

# 调试日志开关 (设 1 开启 DEBUG level)
# WPP_DEBUG=0
