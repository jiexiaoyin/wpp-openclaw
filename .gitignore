src/src/
# build-release.sh 临时产物
dist-release/
# build-release.sh 临时产物
release/
# 测试覆盖率报告
coverage/

# dev 工具/脚本
# dev-only deploy wrapper (如有)
build-release.sh.deploy

# 2026-09-27 审阅加固: 泄漏源物理阻断 (A 方案)
#   这些路径此前被 git 跟踪, 导致 .gitignore 规则实际无效 (对已跟踪文件不生效)。
#   已用 git rm --cached 脱离跟踪; 此处的规则防再次被 git add 带入。
#   判据: 任何分支直推都不得带出真实 wxid/群 ID/生产配置/含敏编译产物。
# 真实运行配置 (真 wxid/管理员/群白名单); 只发布 .example
accounts/default.json
# tsc 编译产物 (含内联真实 URL/ID), 不是源码
dist/
# 同上 (重复声明, 原规则被跟踪状态架空)
dist-release/
# 同上
release/

# 2026-09-27 审阅加固: src/ 下的编译产物 (历史残留, 已被跟踪)
#   本仓 rootDir=./src outDir=./dist ⇒ 产物只应出现在 dist/。
#   现状: 35 个 .js 落在 src/ 且已被提交 (每个都有对应 .ts, dist/ 已完整覆盖, 无一处是手写)。
#   风险: 改 .ts 忘 build 时, src/*.js 是被误信的过期逻辑; 且绕过 dist/ 的脱敏路径。
#   已用 git rm --cached 脱离跟踪; 此规则防再次被带入。
#   ⚠️ 只在 root 层忽略: 用 /src/**/*.js 锚定, 避免误伤未来合法子目录。
src/**/*.js
# .js.map 同理: glob `*.js` 不匹配以 `.map` 结尾的文件, 需单独声明 (2026-09-28 审阅加固)
src/**/*.js.map

# 2026-09-28 审阅加固: 依赖目录不入 git
#   现状: node_modules 被跟踪 12,570 个文件 (磁盘 42,984 个), 而 .gitignore 里没有这条规则。
#   影响: (1) 每次 npm install/ci 都污染 git status (本次装 openclaw 后出现 3,860 项改动);
#         (2) 依赖内容随提交进入历史, 与「只发源码」的发布模型相悖;
#         (3) sanitize-source.sh 的 SKIP_DIRS 跳过 node_modules ⇒ 这批文件绕过脱敏器。
#   已用 git rm -r --cached 脱离跟踪 (磁盘文件保留); 本规则防再次被 git add 带入。
node_modules/
