{
  "_comment": "WeChatPadPro 单账号配置模板. 复制为 accounts/default.json 后填你自己的值. 所有 token/authcode 留空从 env vars 读 (凭证单一来源铁律).",
  "enabled": true,
  "tokenKey": "",
  "tokenKeyEnv": "WECHATPRO_TOKEN_KEY",
  "apiBaseUrl": "http://127.0.0.1:8062",
  "wsUrl": "ws://127.0.0.1:8062/ws/sync",
  "authcode": "",
  "authcodeEnv": "WECHATPRO_AUTHCODE",
  "webhookHost": "127.0.0.1",
  "webhookPort": 4398,
  "webhookPath": "/wechatpadpro/default/webhook",
  "webhookPathToken": "replace-with-random-hex", // v1.3.63 P1-7: 随机 token 插 path 防伪造触发 AI
  "webhookPublicUrl": "",
  "webhookPublicUrlEnv": "WECHATPRO_WEBHOOK_PUBLIC_URL",
  "autoSetWebhook": true,
  "setWebhookRetries": 3,
  "webhookSecret": "",
  "_webhookSecretNote": "留空跳过验签 (vendor 不签时能进). 配了则启用 HMAC 验签.",
  "allowFrom": [],
  "_allowFromNote": "私聊白名单. 空 = 拒绝所有私聊 (fail-closed 防 fan-out). 填你的 wxid 后 bot 只回你.",
  "groupPolicy": "allowlist",
  "groupAllowFrom": [],
  "_groupAllowFromNote": "groupPolicy=allowlist 时, 填允许触发的群 id (e.g. xxx@chatroom).",
  "selfWxid": "YOUR_WXID",
  "nickname": "YourBot",
  "requireAtMention": true,
  "debounceMs": 1500,
  "agent": "wpp-wechat",
  "_agentNote": "OpenClaw agent 绑定, 必填且禁止 'main'.",
  "webhookBusinessPath": "/wechatpadpro/default/webhook/business",
  "webhookSecretEnv": "WECHATPRO_WEBHOOK_SECRET",
  "adminUsers": [],
  "blacklistGroups": [],
  "chatroomDebug": false,
  "_v1.2.0_note": "MCP 增强: 默认 false (vendor realtime 未开通时避免每次文件消息白耗 5s connect; 开通 realtime 后改 true 即用文件 CDN 下载)",
  "mcpEnabled": false
}

